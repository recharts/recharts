{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true /* Generates corresponding '.d.ts' file. */,
    "declarationDir": "./types" /* Output directory for generated declaration files. */,
    "outDir": "./build/",
    /*
     * `build-types` runs `rimraf types` first, so an incremental build would decide nothing had
     * changed and emit nothing into the folder it just deleted. `check-types-lib` reuses this
     * config with --noEmit and turns incremental back on with its own tsbuildinfo file.
     */
    "incremental": false,
    "rootDir": "./src",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "preserveConstEnums": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es6",
    "types": ["node", "vitest/globals"]
  },
  "include": ["./src/**/*", "types.d.ts"]
}
