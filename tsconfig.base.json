{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "react",
    "module": "commonjs",
    "skipLibCheck": true,

    /*
     * Cache type information between runs so repeated `check-types` runs (notably in the pre-push
     * hook) only re-check what actually changed. Each project sets its own `tsBuildInfoFile`,
     * because a shared one would thrash between the emitting and --noEmit invocations.
     */
    "incremental": true,

    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noUncheckedIndexedAccess": true
  }
}
